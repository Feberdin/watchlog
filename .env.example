# Purpose: Public local Docker Compose configuration template for WatchLog.
# Input/Output: Copy to `.env`, replace every change-me value, then run `docker compose up -d --build`.
# Invariants: This file contains examples only. Never commit your real `.env`.
# Debugging: `docker compose config` shows resolved values without starting containers.

APP_URL=http://localhost:8111
APP_PORT=8111
TZ=Europe/Berlin

POSTGRES_DB=watchlog
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=change-me-generate-a-long-random-password
DATABASE_URL=postgresql://watchlog:change-me-generate-a-long-random-password@db:5432/watchlog

SESSION_SECRET=change-me-generate-at-least-32-random-characters
WEBHOOK_SECRET=change-me-generate-a-random-webhook-secret

# Optional integrations. They can also be configured later in the WatchLog UI.
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYSEERR_URL=
JELLYSEERR_API_KEY=
TMDB_BEARER_TOKEN=

REGISTRATION_ENABLED=false
LOG_LEVEL=info
SECURE_COOKIES=false
CACHE_DIR=/cache
