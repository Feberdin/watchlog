# Purpose: Broker-safe example runtime configuration for WatchLog.
# Input/Output: Documents variable names; the Deployment Broker resolves secret:// values.
# Invariants: Keep real secrets out of git. Values ending in _SECRET or _KEY must not be logged.
# Debugging: Set LOG_LEVEL=debug and check broker/container logs.

APP_URL=http://localhost:8111
APP_PORT=8111
TZ=Europe/Berlin

DATABASE_URL=secret://WATCHLOG_DATABASE_URL
POSTGRES_PASSWORD=secret://WATCHLOG_POSTGRES_PASSWORD
SESSION_SECRET=secret://WATCHLOG_SESSION_SECRET
WEBHOOK_SECRET=secret://WATCHLOG_WEBHOOK_SECRET

JELLYFIN_URL=secret://WATCHLOG_JELLYFIN_URL
JELLYFIN_API_KEY=secret://WATCHLOG_JELLYFIN_API_KEY
JELLYSEERR_URL=secret://WATCHLOG_JELLYSEERR_URL
JELLYSEERR_API_KEY=secret://WATCHLOG_JELLYSEERR_API_KEY
TMDB_BEARER_TOKEN=secret://WATCHLOG_TMDB_BEARER_TOKEN

REGISTRATION_ENABLED=false
LOG_LEVEL=info
SECURE_COOKIES=false
