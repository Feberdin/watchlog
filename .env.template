# Purpose: Broker-safe configuration template for WatchLog deployments.
# Input/Output: Non-secret values can be copied into broker repo config; secret values stay in the broker secret store.
# Invariants: Secret values are referenced as secret://NAME only and are never committed in plaintext.
# Debugging: If deployment validation fails, confirm the broker has every required secret listed below.

APP_URL=http://localhost:8111
APP_PORT=8111
TZ=Europe/Berlin

# Required broker secrets:
DATABASE_URL=secret://WATCHLOG_DATABASE_URL
POSTGRES_PASSWORD=secret://WATCHLOG_POSTGRES_PASSWORD
SESSION_SECRET=secret://WATCHLOG_SESSION_SECRET
WEBHOOK_SECRET=secret://WATCHLOG_WEBHOOK_SECRET

# Optional Phase-2/metadata secrets. Phase 1 starts without them.
JELLYFIN_API_KEY=secret://WATCHLOG_JELLYFIN_API_KEY
JELLYSEERR_API_KEY=secret://WATCHLOG_JELLYSEERR_API_KEY
TMDB_BEARER_TOKEN=secret://WATCHLOG_TMDB_BEARER_TOKEN

JELLYFIN_URL=
JELLYSEERR_URL=
REGISTRATION_ENABLED=false
LOG_LEVEL=info
SECURE_COOKIES=false
